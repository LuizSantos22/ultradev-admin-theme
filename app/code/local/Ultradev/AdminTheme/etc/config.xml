<?xml version="1.0"?>
<config>
    <modules>
        <Ultradev_AdminTheme>
            <version>2.0.0</version>
        </Ultradev_AdminTheme>
    </modules>
    <global>
        <blocks>
            <ultradev_admintheme>
                <class>Ultradev_AdminTheme_Block</class>
            </ultradev_admintheme>
        </blocks>
        <models>
            <ultradev_admintheme>
                <class>Ultradev_AdminTheme_Model</class>
            </ultradev_admintheme>
        </models>
        <helpers>
            <ultradev_admintheme>
                <class>Ultradev_AdminTheme_Helper</class>
            </ultradev_admintheme>
        </helpers>
        <events>
            <adminhtml_controller_action_predispatch_start>
                <observers>
                    <ultradev_admintheme_select>
                        <type>singleton</type>
                        <class>ultradev_admintheme/observer</class>
                        <method>selectTheme</method>
                    </ultradev_admintheme_select>
                </observers>
            </adminhtml_controller_action_predispatch_start>
        </events>
    </global>
    <adminhtml>
        <layout>
            <updates>
                <ultradev_admintheme>
                    <file>ultradev/admintheme.xml</file>
                </ultradev_admintheme>
            </updates>
        </layout>
    </adminhtml>
    <default>
        <admin>
            <ultradev_admintheme>
                <enable>1</enable>
                <dashboard>1</dashboard>
            </ultradev_admintheme>
        </admin>
    </default>
</config>
