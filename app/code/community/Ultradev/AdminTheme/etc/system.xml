<?xml version="1.0"?>
<config>
    <sections>
        <admin>
            <groups>
                <ultradev_admintheme translate="label" module="ultradev_admintheme">
                    <label>Ultra Admin Theme</label>
                    <frontend_type>text</frontend_type>
                    <sort_order>5</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>0</show_in_website>
                    <show_in_store>0</show_in_store>
                    <fields>
                        <enable translate="label comment">
                            <label>Ativar tema Ultra</label>
                            <comment>Desative para voltar imediatamente ao tema padrão do admin.</comment>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>10</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </enable>
                        <dashboard translate="label comment">
                            <label>Usar o Painel Ultra</label>
                            <comment>Substitui o dashboard nativo (gráficos e seletor de período) pelo painel resumido. Desative para ver o dashboard nativo.</comment>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>20</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </dashboard>
                    </fields>
                </ultradev_admintheme>
            </groups>
        </admin>
    </sections>
</config>
