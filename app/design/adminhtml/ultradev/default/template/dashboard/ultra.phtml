<?php
/** @var Ultradev_AdminTheme_Block_Dashboard $this */
$sum    = $this->getSummary();
$orders = $this->getLastOrders();
$best   = $this->getBestSellers();
$top    = $this->getTopTerms();
$recent = $this->getRecentTerms();

$bestMax = 1;
foreach ($best as $b) { $bestMax = max($bestMax, (float)$b['qty']); }

$termRows = function ($items) use ($this) {
    $max = 1;
    foreach ($items as $t) { $max = max($max, (int)$t->getPopularity()); }
    $h = '';
    foreach ($items as $t) {
        $res = (int)$t->getNumResults();
        $pop = (int)$t->getPopularity();
        $h .= '<tr><td class="ux-kw">' . $this->escapeHtml($t->getQueryText())
            . ($res <= 2 ? '<span class="ux-chip">poucos resultados</span>' : '')
            . '</td><td class="ux-r ux-num">' . $res . '</td>'
            . '<td class="ux-r"><span class="ux-freq"><span class="ux-track"><i style="width:' . round($pop / $max * 100) . '%"></i></span>'
            . '<span class="ux-num">' . $this->number($pop, 0) . '</span></span></td></tr>';
    }
    return $h ?: '<tr><td colspan="3" class="ux-empty">Sem dados ainda.</td></tr>';
};
?>
<div class="ux-dash">
    <div class="ux-head">
        <div>
            <h1>Painel de controle</h1>
            <p>Visão geral da loja Ultraeletrônicos.</p>
        </div>
        <div class="ux-acts">
            <a class="ux-btn ux-pri" href="<?php echo $this->escapeHtml($this->getUrl('adminhtml/cache/index')) ?>">Gerenciar cache</a>
        </div>
    </div>

    <section class="ux-hero" aria-label="Indicadores principais">
        <div class="ux-big">
            <div class="ux-tag"><svg viewBox="0 0 24 24"><path d="M3 17l6-6 4 4 8-8M15 7h6v6"/></svg>Faturamento acumulado</div>
            <p class="ux-rev ux-num"><small><?php echo $this->escapeHtml($this->getCurrencySymbol()) ?></small><?php echo $this->number($sum['revenue']) ?></p>
        </div>
        <div class="ux-side2">
            <div class="ux-tag"><svg viewBox="0 0 24 24"><path d="M9 19v-6H5v6a2 2 0 002 2h2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10M9 19a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2"/></svg>Ticket médio</div>
            <p class="ux-tk ux-num"><?php echo $this->money($sum['average']) ?></p>
            <p class="ux-desc">Valor médio por pedido no ciclo de vendas.</p>
        </div>
    </section>

    <div class="ux-grid">
        <section class="ux-panel ux-c5" aria-labelledby="ux-h-ped">
            <header><h2 id="ux-h-ped">Últimos 5 pedidos</h2><span>Toque para abrir</span></header>
            <ul class="ux-orders" id="ux-orders">
            <?php foreach ($orders as $o):
                $name  = $o->getCustomerName();
                $items = (int)$o->getTotalItemCount();
                $total = $this->money($o->getBaseGrandTotal());
                $url   = $this->getUrl('adminhtml/sales_order/view', array('order_id' => $o->getId())); ?>
                <li tabindex="0" role="button"
                    data-name="<?php echo $this->escapeHtml($name) ?>"
                    data-total="<?php echo $this->escapeHtml(html_entity_decode($total, ENT_QUOTES, 'UTF-8')) ?>"
                    data-items="<?php echo $items ?>"
                    data-url="<?php echo $this->escapeHtml($url) ?>">
                    <span class="ux-ini"><?php echo $this->escapeHtml($this->initials($name)) ?></span>
                    <span class="ux-who"><b><?php echo $this->escapeHtml($name) ?></b><small><?php echo $items ?> <?php echo $items === 1 ? 'produto' : 'produtos' ?></small></span>
                    <span class="ux-tot ux-num"><?php echo $total ?></span>
                </li>
            <?php endforeach; ?>
            <?php if (!$orders->getSize()): ?><li class="ux-empty">Nenhum pedido ainda.</li><?php endif; ?>
            </ul>
        </section>

        <section class="ux-panel ux-c7" aria-labelledby="ux-h-top">
            <header><h2 id="ux-h-top">Produtos mais vendidos</h2><span>Unidades vendidas</span></header>
            <ol class="ux-rank">
            <?php $i = 0; foreach ($best as $b): $i++; $q = (float)$b['qty']; ?>
                <li>
                    <span class="ux-pos ux-num"><?php echo $i ?></span>
                    <span class="ux-nm"><?php echo $this->escapeHtml($b['name']) ?></span>
                    <span class="ux-qt ux-num"><?php echo (int)$q ?></span>
                    <span class="ux-meta">
                        <span class="ux-track"><i style="width:<?php echo round($q / $bestMax * 100) ?>%"></i></span>
                        <span class="ux-pr ux-num"><?php echo $this->money($b['price']) ?></span>
                    </span>
                </li>
            <?php endforeach; ?>
            <?php if (!$best): ?><li class="ux-empty">Sem vendas ainda.</li><?php endif; ?>
            </ol>
        </section>

        <section class="ux-panel ux-c6" aria-labelledby="ux-h-term">
            <header><h2 id="ux-h-term">Termos mais procurados</h2><span>Top 5 por frequência</span></header>
            <div class="ux-sc"><table class="ux-table">
                <thead><tr><th>Palavra-chave</th><th class="ux-r">Resultados</th><th class="ux-r">Frequência</th></tr></thead>
                <tbody><?php echo $termRows($top) ?></tbody>
            </table></div>
            <p class="ux-note">Termos com poucos resultados e muita busca indicam produtos que faltam no catálogo.</p>
        </section>

        <section class="ux-panel ux-c6" aria-labelledby="ux-h-rec">
            <header><h2 id="ux-h-rec">Últimas 5 pesquisas</h2><span>Buscas recentes na loja</span></header>
            <div class="ux-sc"><table class="ux-table">
                <thead><tr><th>Palavra-chave</th><th class="ux-r">Resultados</th><th class="ux-r">Frequência</th></tr></thead>
                <tbody><?php echo $termRows($recent) ?></tbody>
            </table></div>
        </section>
    </div>
</div>

