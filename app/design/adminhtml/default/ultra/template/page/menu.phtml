        $iconKey  = isset($icons[$key]) ? $key : (isset($labelIcons[$labelKey]) ? $labelIcons[$labelKey] : null);
        $icon     = $iconKey ? $icons[$iconKey] : $fallback;
        $active   = !empty($item['active']);
        $label    = $this->escapeHtml($item['label']);
