// Se as chaves do array não forem os ids do menu, tenta pelo rótulo (pt-BR).
$labelIcons = array(
    'painel de controle' => 'dashboard', 'painel' => 'dashboard', 'vendas' => 'sales',
    'catálogo' => 'catalog', 'clientes' => 'customer', 'promoções' => 'promo',
    'newsletter' => 'newsletter', 'cms' => 'cms', 'relatórios' => 'report', 'sistema' => 'system',
);
$fallback = '<circle cx="12" cy="12" r="3"/>';

$sub = function (array $items, $depth) use ($self, &$sub) {
    $h = '';
    foreach ($items as $it) {
        $click = !empty($it['click']) ? ' onclick="' . $self->escapeHtml($it['click']) . '"' : '';
        $title = !empty($it['title']) ? ' title="' . $self->escapeHtml($it['title']) . '"' : '';
        $cls   = 'd' . $depth . (!empty($it['active']) ? ' on' : '');
        $h .= '<a href="' . $self->escapeHtml($it['url']) . '" class="' . $cls . '"' . $click . $title . '>'
            . $self->escapeHtml($it['label']) . '</a>';
        if (!empty($it['children'])) {
            $h .= '<div class="ux-sub2">' . $sub($it['children'], $depth + 1) . '</div>';
        }
    }
    return $h;
};

$user = Mage::getSingleton('admin/session')->getUser();
$ver  = method_exists('Mage', 'getOpenMageVersion') ? Mage::getOpenMageVersion() : Mage::getVersion();
$i = 0;
