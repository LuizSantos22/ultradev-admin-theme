            </a>
        <?php else: ?>
            <button type="button" class="ux-item ux-group<?php echo $active ? ' cur' : '' ?>" title="<?php echo $label ?>"
                    aria-expanded="<?php echo $active ? 'true' : 'false' ?>" aria-controls="ux-s<?php echo $i ?>">
                <svg viewBox="0 0 24 24"><?php echo $icon ?></svg><span class="ux-lbl"><?php echo $label ?></span>
                <svg class="ux-chev ux-lbl" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg>
            </button>
            <div class="ux-sub<?php echo $active ? ' open' : '' ?>" id="ux-s<?php echo $i ?>"><div><?php echo $sub($children, 1) ?></div></div>
        <?php endif;
    endforeach; ?>
